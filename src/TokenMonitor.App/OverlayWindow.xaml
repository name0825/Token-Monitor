<Window x:Class="TokenMonitor.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TokenMonitor.App.ViewModels"
        Title="Token Monitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border x:Name="PanelBorder" CornerRadius="8" Padding="8">
        <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToolUsageViewModel}">
                    <Grid Margin="0,3" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding DisplayName}" Foreground="#FFEEEEEE"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Grid.Row="0" Text="5h" Foreground="#FF8A8A8A" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0,6,0" />
                        <Border Grid.Column="2" Grid.Row="0" Width="64" Height="5" CornerRadius="2.5" Background="#33FFFFFF"
                                VerticalAlignment="Center">
                            <Rectangle Width="{Binding FiveHourBarWidth}" Fill="{Binding FiveHourBrush}"
                                       RadiusX="2.5" RadiusY="2.5" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock Grid.Column="3" Grid.Row="0" Text="{Binding FiveHourText}" Foreground="#FFEEEEEE" FontSize="11"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="4" Grid.Row="0" Text="{Binding FiveHourReset}" Foreground="#FFB0B0B0" FontSize="11"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="4,0,0,0" />

                        <TextBlock Grid.Column="1" Grid.Row="1" Text="주간" Foreground="#FF8A8A8A" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0,6,0" />
                        <Border Grid.Column="2" Grid.Row="1" Width="64" Height="5" CornerRadius="2.5" Background="#33FFFFFF"
                                VerticalAlignment="Center">
                            <Rectangle Width="{Binding WeeklyBarWidth}" Fill="{Binding WeeklyBrush}"
                                       RadiusX="2.5" RadiusY="2.5" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock Grid.Column="3" Grid.Row="1" Text="{Binding WeeklyText}" Foreground="#FFEEEEEE" FontSize="11"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding WeeklyReset}" Foreground="#FFB0B0B0" FontSize="11"
                                   VerticalAlignment="Center" TextAlignment="Right" Margin="4,0,0,0" />

                        <StackPanel Grid.Column="5" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding ErrorText}" Foreground="#FFE57373" FontSize="11"
                                       Margin="0,0,6,0"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding StatusText}" Foreground="#FF7A7A7A" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
